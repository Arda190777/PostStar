PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/forum

# Signs the login tokens. Use a long random value and never commit the real one.
# Required when NODE_ENV=production — the server refuses to start without it.
JWT_SECRET=your-secret-key-here

# How long a login token stays valid, in seconds (default 86400 = 24 hours)
JWT_EXPIRES_IN_SECONDS=86400

# Credentials for the admin account created by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

meta {
  name: Add Comment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/posts/:postId/comments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

params:path {
  postId: REPLACE_WITH_POST_ID
}

body:json {
  {
    "content": "Great post!"
  }
}

docs {
  Adds a top-level comment. To reply to an existing comment instead, add a
  `parentId` field — see the "Reply To Comment" request.
}
